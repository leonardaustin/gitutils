#!/usr/bin/env bash
set -euo pipefail

# git diff returns 1 for differences and >1 for errors.
changed() {
  local rc
  git diff --quiet --no-renames "$@" && return 1
  rc=$?
  [[ $rc == 1 ]] || exit "$rc"
}

check_ref() (
  local tip=$1 old=$2 base='' main tmp name module
  local -a lock=() lint_args=()
  if main=$(git rev-parse -q --verify 'refs/remotes/origin/main^{commit}'); then
    base=$(git merge-base "$tip" "$main") || base=
  fi
  if ! old=$(git rev-parse -q --verify "${old}^{commit}" 2>/dev/null); then
    # With neither comparison commit, treat the pushed tree as new.
    old=${base:-$(git hash-object -t tree /dev/null)}
  fi
  changed "$old" "$tip" -- '*.go' ':(glob)**/go.mod' ':(glob)**/go.sum' .golangci.yml || return 0

  # Check the pushed tree, including when another branch is checked out.
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXXXX")
  trap 'rm -rf "$tmp"' EXIT
  while read -r name; do unset "$name"; done < <(git rev-parse --local-env-vars)
  git clone -q --shared --no-checkout . "$tmp/tree"
  cd "$tmp/tree"
  git checkout -q --detach "$tip"

  for module in gitcloneall gitpullall goget; do
    (cd "$module" && go mod tidy -diff)
  done
  if command -v iddio >/dev/null && iddio lock list >/dev/null; then
    lock=(iddio lock run heavy --)
  fi
  if [[ -n "$base" ]]; then
    lint_args=(--new-from-rev="$base")
  fi
  for module in gitcloneall gitpullall goget; do
    (cd "$module" && ${lock[@]+"${lock[@]}"} golangci-lint run ${lint_args[@]+"${lint_args[@]}"} ./...)
  done
)

while read -r _ local_oid _ remote_oid; do
  tip=$(git rev-parse -q --verify "${local_oid}^{commit}" 2>/dev/null) || continue
  check_ref "$tip" "$remote_oid"
done
